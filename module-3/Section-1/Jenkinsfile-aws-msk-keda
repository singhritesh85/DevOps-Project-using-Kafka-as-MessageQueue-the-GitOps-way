pipeline{
    agent{
        node{
            label "Slave-1"
            customWorkspace "/home/k8s-management/aws-msk/"
        }
    }
    environment {
        JAVA_HOME="/usr/lib/jvm/java-25-amazon-corretto.x86_64"
        PATH="$PATH:$JAVA_HOME/bin:/usr/local/bin:/opt/apache-maven/bin:/opt/node-v16.0.0/bin"
        ARGOCD_PASSWORD=credentials('argocd-password')
        GITHUB_USERNAME=credentials('github-username')
        GITHUB_PASSWORD=credentials('github-password')
    }
    parameters {
		string(name: 'MSK_CLUSTER_ARN', defaultValue: '', description: 'Provide the AWS MSK Cluster ARN')
        choice(name: 'AWS_REGION', choices: ['us-east-2', 'us-east-1', 'us-west-2', 'us-west-1', 'ap-south-1', 'ap-south-2'], description: 'Select the AWS Region')
    }
    stages{
        stage("Deployment"){
            steps{
                sh 'yes|argocd login argocd.singhritesh85.com --username admin --password ${ARGOCD_PASSWORD} --grpc-web'
                sh 'argocd repo add https://github.com/singhritesh85/helm-repo-for-msk-keda.git --username ${GITHUB_USERNAME} --password ${GITHUB_PASSWORD}'
                sh """argocd app create aws-msk-keda --project default --repo https://github.com/singhritesh85/helm-repo-for-msk-keda.git --path ./keda-msk --dest-namespace producer-consumer --sync-option CreateNamespace=true --dest-server https://kubernetes.default.svc --sync-policy automated --helm-set bootstrapServers=\$(aws kafka get-bootstrap-brokers --cluster-arn "${MSK_CLUSTER_ARN}" --region ${AWS_REGION} --query 'BootstrapBrokerStringSaslIam' --output text) --helm-set awsRegion=${AWS_REGION} --helm-set consumerGroup="eks-group" --helm-set topic="kafka-demo-topic" --helm-set minReplicas=1 --helm-set maxReplicas=5 --upsert"""
                //sh 'argocd app sync aws-msk-keda'
                sh 'kubectl get scaledobject -n producer-consumer'
                sh 'kubectl describe scaledobject kafka-consumer-scaler -n producer-consumer'
            }
        }
    }
}
